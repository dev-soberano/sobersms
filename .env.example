# ============================================================
#  SoberSMS — configuração mínima
#  Copie este arquivo para .env e preencha.
#  Depois, quase tudo se configura pelo próprio Telegram
#  (menu ⚙️ Configurações).
# ============================================================

# Token do seu bot, criado no @BotFather (comando /newbot)
BOT_TOKEN=COLE_SEU_TOKEN_AQUI

# (Opcional) Quem controla o bot, separado por vírgula.
# Deixe VAZIO para o primeiro usuário que abrir o bot virar dono.
ADMIN_IDS=

# Nome que aparece no bot (mudável depois pelo Telegram)
BOT_NAME=SoberSMS

# ============================================================
#  Opcional: já deixar configurado antes do primeiro /start
#  (também dá para preencher depois pelo Telegram)
# ============================================================
# Chave da API de números (gsk_live_...), do painel do seu site → 🔌 API
API_KEY=

# Pagamento: misticpay ou mercadopago
PAGAMENTO=misticpay
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=
MP_ACCESS_TOKEN=

# Preços: Brasil fixo e multiplicador fora do Brasil
BRAZIL_PRICE=13
PRICE_MULTIPLIER=2

# Recarga mínima e máxima (R$)
MIN_DEPOSIT=5
MAX_DEPOSIT=500

# Porta do servidor interno (webhook/healthcheck)
PORT=25594
